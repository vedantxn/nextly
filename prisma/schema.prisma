generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth tables ─────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions             Session[]
  accounts             Account[]
  memberships          Member[]
  invitationsSent      Invitation[]  @relation("InvitationInviter")
  personalOrganization Organization? @relation("PersonalOrganizationOwner")

  @@map("user")
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganizationSessions", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─── App tables ─────────────────────────────────────────────

enum Visibility {
  PUBLIC
  PRIVATE
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logo              String?
  metadata          Json?
  kind              String   @default("TEAM")
  personalForUserId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  personalForUser User?           @relation("PersonalOrganizationOwner", fields: [personalForUserId], references: [id], onDelete: Cascade)
  activeSessions  Session[]       @relation("ActiveOrganizationSessions")
  members         Member[]
  invitations     Invitation[]
  projects        Project[]
  generationJobs  GenerationJob[]
  usage           Usage?

  @@index([kind])
  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

model Project {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  visibility     Visibility @default(PRIVATE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
  generationJobs GenerationJob[]

  @@index([organizationId])
  @@index([updatedAt])
  @@map("project")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id        String      @id @default(uuid())
  projectId String
  role      MessageRole
  type      MessageType
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fragment      Fragment?
  triggeredJobs GenerationJob[] @relation("TriggerMessageGenerationJobs")

  @@index([projectId])
  @@index([createdAt])
  @@map("message")
}

model Fragment {
  id         String   @id @default(uuid())
  messageId  String   @unique
  sandboxUrl String
  title      String
  files      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("fragment")
}

model Usage {
  id             String   @id @default(uuid())
  organizationId String   @unique
  points         Int      @default(0)
  periodStart    DateTime @default(now())
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("usage")
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model GenerationJob {
  id               String              @id @default(cuid())
  projectId        String
  organizationId   String
  triggerMessageId String              @unique
  workflowRunId    String?
  status           GenerationJobStatus @default(QUEUED)
  model            String
  attemptCount     Int                 @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggerMessage Message      @relation("TriggerMessageGenerationJobs", fields: [triggerMessageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId, createdAt])
  @@index([status])
  @@map("generation_job")
}

model RateLimiter {
  key    String    @id
  points Int
  expire DateTime?

  @@map("rate_limiter")
}
